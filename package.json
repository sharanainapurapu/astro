{
  "name": "jyotish-vedic-astrology",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static Vedic astrology web app: in-browser chart calculations, Vimshottari dasha, transits, and rule-based predictions cited from public-domain classical texts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:kb": "node scripts/build-knowledge-base.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
